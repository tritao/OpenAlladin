{
  "format": "openaladdin-player-terrain-experiments-v1",
  "rom_scope": "fixed Disneys_Aladdin_U_p1.bin",
  "state_trace_format": "openaladdin-frame-state-v1",
  "pipeline": {
    "input_query_byte": "0x00FFF156",
    "direction_flags": {
      "0x00FFF07C": "!bit3(input_query_byte), right pressed",
      "0x00FFF07D": "!bit2(input_query_byte), left pressed",
      "0x00FFF07E": "!bit0(input_query_byte), up pressed",
      "0x00FFF07F": "!bit1(input_query_byte), down pressed"
    },
    "resolver": {
      "function": "0x001B1E38",
      "terrain_y": "WORLD_CAMERA_Y + PLAYER_Y - 0x00F0",
      "row": "terrain_y >> 4 through TERRAIN_ROW_POINTER_TABLE",
      "column": "(WORLD_CAMERA_X + PLAYER_X + 0x0010) >> 4",
      "terrain_word": "big-endian map word",
      "behavior": "floor[2 + (terrain_word >> 1)]",
      "dispatch": "TERRAIN_RESPONSE_HANDLER_TABLE[behavior]"
    }
  },
  "experiments": {
