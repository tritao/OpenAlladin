    "dispatch": "handler is called on every resolver pass; handler-local guards/latches control repetition",
    "surface_mode": "FFF0A4 is the toggled mode word; FFF0C2 is the 0x47 one-shot latch",
    "landing_response": "behavior 0x30 subtracts 0x7C from PLAYER_VY, clears FFF0B0/FFF0CC, arms FFF0C1, and aligns PLAYER_X through 0x001A99C6",
    "launch_response": "behavior 0x29 requires FFF0BE clear, writes PLAYER_VX=-0x400 and PLAYER_VY=-0x500, clears FFF0C0/FFF0CC, and sets FFF0BE",
    "removed_heuristics": ["nearby support-row search", "behavior < 0xE0 solid test", "player-sized horizontal rectangle scan"]
